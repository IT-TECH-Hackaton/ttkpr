{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173,
      "env": { "HTTPS": "1" },
      "url": "https://localhost:5173"
    },
    {
      "name": "viewer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ttkpr/viewer", "dev"],
      "port": 5173,
      "env": { "HTTPS": "1" },
      "url": "https://localhost:5173"
    },
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ttkpr/studio", "dev"],
      "port": 5174,
      "url": "http://localhost:5174"
    }
  ]
}
