**/dist
**/.turbo
**/.vite
**/coverage
**/test-results
**/playwright-report
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
data
infra/volumes
.git
.github
**/.env
**/.env.*
!**/.env.example
*.log
*.pem
*.key
