# Copy to infra/.env and change every secret before exposing the stack.
VIEWER_HOST=localhost
STUDIO_HOST=studio.localhost

POSTGRES_USER=ttk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ttk

# Local S3 (SeaweedFS); must match infra/seaweedfs/s3.json
S3_ACCESS_KEY=ttk-local
S3_SECRET_KEY=ttk-local-secret
S3_BUCKET=ttk
