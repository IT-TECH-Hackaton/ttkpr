# Copy to infra/.env and change every secret before exposing the stack.
# Public host name: the visitor map at https://SITE_HOST/, the studio at https://SITE_HOST/studio/
# For a phone on the same Wi-Fi use the machine's LAN IP, e.g. SITE_HOST=192.168.1.20.
SITE_HOST=localhost
# Optional: force the origin in share links and QR codes (a tunnel in front of the stack).
PUBLIC_URL=

POSTGRES_USER=ttk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ttk

# Signs the QR capture links; any long random string.
SECRET_KEY=
